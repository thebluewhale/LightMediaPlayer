<Window x:Class="LightMediaPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Light Media Player" Width="1040" Height="680" MinWidth="680" MinHeight="400" Background="#11161C" Foreground="#E8EDF3" FontFamily="Segoe UI, Malgun Gothic" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" UseLayoutRounding="True" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown" DragOver="Window_DragOver" Drop="Window_Drop">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#313A44" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Height="44" Background="#181F27">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="▶" Foreground="{StaticResource Accent}" FontSize="15" Margin="18,0,10,0" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="LIGHT" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="  MEDIA PLAYER" Foreground="#8A98A8" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" ToolTip="최소화" AutomationProperties.Name="최소화" Click="Minimize_Click"/><Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="46" ToolTip="최대화 / 복원" AutomationProperties.Name="최대화" Click="Maximize_Click"/><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="46" ToolTip="종료" AutomationProperties.Name="종료" Click="Close_Click"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Background="Black">
   <vlc:VideoView x:Name="Video" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid x:Name="VideoOverlay" Background="Transparent" MouseLeftButtonDown="Video_MouseLeftButtonDown" MouseRightButtonUp="Video_MouseRightButtonUp" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
      <Border Width="68" Height="68" CornerRadius="22" Background="#182C2B" HorizontalAlignment="Center" Margin="0,0,0,22"><TextBlock Text="▶" Foreground="{StaticResource Accent}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/></Border>
      <TextBlock x:Name="EmptyTitle" Text="가볍게 열고, 편하게 감상하세요" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" Foreground="#E8EDF3"/>
      <TextBlock x:Name="EmptyDetail" Text="영상이나 음악 파일을 여기에 놓으세요" Foreground="#8593A3" FontSize="13" TextAlignment="Center" Margin="0,12,0,24" TextWrapping="Wrap"/>
      <Button x:Name="EmptyOpenButton" Content="파일 열기    Ctrl+O" Foreground="#152722" Background="{StaticResource Accent}" HorizontalAlignment="Center" Padding="22,11" Click="Open_Click"/>
     </StackPanel>
    </Grid>
   </vlc:VideoView>
  </Grid>
  <Grid Grid.Row="2" Margin="17,9,17,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
   <Slider x:Name="SeekBar" Minimum="0" Maximum="1" Value="0" IsEnabled="False" PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseMove="Seek_MouseMove" PreviewMouseLeftButtonUp="Seek_MouseUp" LostMouseCapture="Seek_LostCapture" AutomationProperties.Name="재생 위치"/>
   <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00" FontSize="11" Foreground="#9CAAB9" VerticalAlignment="Center" Margin="15,0,12,0" FontFamily="Consolas"/>
   <Button x:Name="MuteButton" Grid.Column="2" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="38" Padding="8" Click="Mute_Click" ToolTip="음소거 (M)" AutomationProperties.Name="음소거"/>
   <Slider x:Name="VolumeBar" Grid.Column="3" Minimum="0" Maximum="100" Value="75" IsMoveToPointEnabled="True" ValueChanged="Volume_Changed" AutomationProperties.Name="음량"/>
  </Grid>
  <Grid Grid.Row="3" Margin="17,5,17,12" Height="44">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20" Background="#27433F" Foreground="{StaticResource Accent}" Width="48" Click="Play_Click" ToolTip="재생 (Space)" AutomationProperties.Name="재생"/>
    <Button x:Name="StopButton" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="43" Click="Stop_Click" ToolTip="정지 (S)" AutomationProperties.Name="정지"/>
    <Button x:Name="PreviousButton" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="40" Click="Previous_Click" ToolTip="이전 파일 (Page Up)" AutomationProperties.Name="이전 파일"/>
    <Button x:Name="NextButton" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="40" Click="Next_Click" ToolTip="다음 파일 (Page Down)" AutomationProperties.Name="다음 파일"/>
   </StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="17,0,12,0"><TextBlock x:Name="FileText" Text="재생할 파일을 선택하세요" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StatusText" Text="준비 중" Foreground="#8B9AA9" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal">
    <Button Content="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="38" Click="Open_Click" ToolTip="파일 열기 (Ctrl+O)" AutomationProperties.Name="파일 열기"/>
    <Button x:Name="TracksButton" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="38" Click="Tracks_Click" ToolTip="자막 · 트랙 · 재생 메뉴" AutomationProperties.Name="트랙 메뉴"/>
    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="38" Opacity="0.45" ToolTip="설정 — 준비 중" AutomationProperties.Name="설정 (준비 중)"/>
    <Button Content="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="38" Opacity="0.45" ToolTip="재생목록 — 준비 중" AutomationProperties.Name="재생목록 (준비 중)"/>
   </StackPanel>
  </Grid>
 </Grid></Border>
</Window>
