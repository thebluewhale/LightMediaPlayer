<Window x:Class="LightMediaPlayer.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="Assets/player.ico"
 Title="설정 — Light Media Player" Width="650" Height="450" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#181F27" Foreground="#E8EDF3" FontFamily="Segoe UI, Malgun Gothic" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#AEBAC8"/><Setter Property="Padding" Value="16,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="#181F27" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#263D3B"/><Setter Property="Foreground" Value="#8CE5D5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11161C"/><Setter Property="Foreground" Value="#E8EDF3"/><Setter Property="BorderBrush" Value="#41505F"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/></Style>
 </Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl x:Name="Categories" Background="#1D2731" Foreground="#E8EDF3" BorderThickness="0" SelectedIndex="1">
   <TabItem Header="기본"/>
   <TabItem Header="재생"><StackPanel Margin="22,20" TextElement.Foreground="#E8EDF3">
    <TextBlock Text="이동시간" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="앞뒤로 이동할 시간을 1초 단위로 설정합니다. (1–86,400초)" Foreground="#94A4B5" FontSize="11" Margin="0,0,0,18"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="86"/><ColumnDefinition Width="34"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
     <TextBlock Text="왼쪽 / 오른쪽 방향키" VerticalAlignment="Center"/><Button Grid.Column="1" Content="−" Tag="plain:-1" Click="Step_Click" Padding="6"/><TextBox x:Name="PlainSeconds" Grid.Column="2" TextChanged="Seconds_Changed" AutomationProperties.Name="방향키 이동시간"/><Button Grid.Column="3" Content="+" Tag="plain:1" Click="Step_Click" Padding="6"/><TextBlock Grid.Column="4" Text="초" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="1" Text="Ctrl + 왼쪽 / 오른쪽 방향키" VerticalAlignment="Center"/><Button Grid.Row="1" Grid.Column="1" Content="−" Tag="ctrl:-1" Click="Step_Click" Padding="6"/><TextBox x:Name="CtrlSeconds" Grid.Row="1" Grid.Column="2" TextChanged="Seconds_Changed" AutomationProperties.Name="Ctrl 방향키 이동시간"/><Button Grid.Row="1" Grid.Column="3" Content="+" Tag="ctrl:1" Click="Step_Click" Padding="6"/><TextBlock Grid.Row="1" Grid.Column="4" Text="초" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="2" Text="Shift + 왼쪽 / 오른쪽 방향키" VerticalAlignment="Center"/><Button Grid.Row="2" Grid.Column="1" Content="−" Tag="shift:-1" Click="Step_Click" Padding="6"/><TextBox x:Name="ShiftSeconds" Grid.Row="2" Grid.Column="2" TextChanged="Seconds_Changed" AutomationProperties.Name="Shift 방향키 이동시간"/><Button Grid.Row="2" Grid.Column="3" Content="+" Tag="shift:1" Click="Step_Click" Padding="6"/><TextBlock Grid.Row="2" Grid.Column="4" Text="초" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
   </StackPanel></TabItem>
   <TabItem Header="자막"/><TabItem Header="장치"/><TabItem Header="코덱/필터"/><TabItem Header="영상"/><TabItem Header="소리"/>
  </TabControl>
  <TextBlock x:Name="ValidationText" Grid.Row="1" Foreground="#FF9791" Margin="0,10,0,8" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True" Padding="24,9" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="저장" IsDefault="True" Click="Save_Click" Background="#27433F" Foreground="#8CE5D5" Padding="24,9"/></StackPanel>
 </Grid>
</Window>
